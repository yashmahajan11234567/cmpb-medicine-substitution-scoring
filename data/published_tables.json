 "method": {
  "encoding": "ATC | BDF | AME | ISI | RCA | TRN | NDXUP",
  "st_weights": {
   "BDF": 0.46,
   "AME": 0.18,
   "ISI": 0.2,
   "RCA": 0.09,
   "TRN": 0.07
  },
  "ds_equivalent_threshold": 100.0,
  "ds_substitution_threshold": 100.0,
  "nrd_formula": "NRD = 100 * |RP_i - RP_j| / max(RP_i, RP_j) over the ST scale of Table 1",
  "ds_formula": "DS = 100 - sum_i w_i * penalty_i(NRD_i) - penalty_NDXUP",
  "max_st_penalty": 80,
  "max_ndxup_penalty": 10
 },
